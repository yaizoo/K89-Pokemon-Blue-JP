-- ------------------------------------------------
-- Battle victory text.
--
-- These cannot be represented exactly as plain Strings() overrides:
--
-- English:
--   PLAYER defeated TRAINER!
--
-- Japanese Blue:
--   TRAINERとの
--   しょうぶに　かった！
--
-- The Japanese source deliberately does not print PLAYER there.
--
-- Likewise prize money is:
--   PLAYERは　しょうきんとして
--   N円　てにいれた！
--
-- Extend the existing sayNext wrapper and rewrite those already-formatted
-- English messages.
-- ------------------------------------------------

local JPBattleCleanup = require("src.battle.BattleState")
local previousCleanupSayNext = JPBattleCleanup.sayNext

JPBattleCleanup.sayNext = function(self, message, ...)
  if type(message) == "string" then

    -- PLAYER defeated TRAINER!
    local player, trainer =
      message:match("^(.-) defeated\n(.-)!$")

    if player and trainer then
      message =
        trainer .. "との\n" ..
        "しょうぶに　かった！"
    else
      -- PLAYER got ¥N / for winning!
      local winner, amount =
        message:match("^(.-) got ¥(%d+)\nfor winning!$")

      if winner and amount then
        message =
          winner .. "は　しょうきんとして\n" ..
          amount .. "円　てにいれた！"
      end
    end
  end

  return previousCleanupSayNext(self, message, ...)
end

-- ------------------------------------------------
-- Hardcoded drawing strings.
--
-- StatBox does NOT use Strings(), so translate only its exact labels at
-- its exact coordinates.
--
-- Japanese labels:
--   ATTACK  -> こうげき
--   DEFENSE -> ぼうぎょ
--   SPEED   -> すばやさ
--   SPECIAL -> とくしゅ
--
-- The battle menu's Pokémon entry is not a string: recomp already draws
-- the original compact PK/MN special glyph pair directly. Preserve it.
-- ------------------------------------------------

local JPFontCleanup = require("src.render.Font")

local previousCleanupDraw = JPFontCleanup.draw
local previousCleanupDrawCode = JPFontCleanup.drawCode

local JP_STAT_LABELS = {
  ATTACK  = "こうげき",
  DEFENSE = "ぼうぎょ",
  SPEED   = "すばやさ",
  SPECIAL = "とくしゅ",
}

JPFontCleanup.draw = function(value, x, y, ...)
  -- StatBox labels are all drawn at x=88, y=24/40/56/72.
  if x == 88
      and (y == 24 or y == 40 or y == 56 or y == 72)
      and JP_STAT_LABELS[value] then
    value = JP_STAT_LABELS[value]
  end

  return previousCleanupDraw(value, x, y, ...)
end

JPFontCleanup.drawCode = function(code, x, y, ...)
  -- Preserve the engine's original PK/MN special glyphs.
  return previousCleanupDrawCode(code, x, y, ...)
end


