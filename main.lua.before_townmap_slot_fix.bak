-- ================================================================
-- JAPANESE BLUE TRAINER AI ITEM TEXT
--
-- TrainerAI.useItem must remain unmodified here. BattleState applies
-- prefixEnemy() to TrainerAI messages before sayNext(), so inserting the
-- enemy Pokemon name at TrainerAI level causes the literal English prefix
-- "Enemy " to be injected into the Japanese sentence.
--
-- The exact Japanese Blue item-use sentence is therefore reconstructed in
-- the final BattleState.sayNext wrapper below, after prefixEnemy() has run.
-- ================================================================



-- ================================================================
-- JAPANESE BLUE AUTHENTIC LINK-BATTLE RESULTS
--
-- Original Japanese Blue:
--
-- Win:
--   <TRAINER>との
--   しょうぶに　かった！
--
-- Lose:
--   <TRAINER>との
--   しょうぶに　まけた！
--
-- gen1recomp instead emits:
--   "<LOSER> is out of\nPOKéMON!\f<WINNER> wins!"
--
-- Rewrite only that exact recomp-added result format.
-- Blue only because the entire mod is already GameVersion.isBlue()-guarded.
-- ================================================================

local JPLinkBattleState = require("src.battle.BattleState")
local previousJPLinkSayNext = JPLinkBattleState.sayNext

JPLinkBattleState.sayNext = function(self, message, ...)
  if type(message) == "string"
      and self
      and self.kind == "link"
      and self.game
      and self.game.save
      and self.game.save.player then

    local loser, winner =
      message:match("^(.-) is out of\nPOKéMON!\f(.-) wins!$")

    if loser and winner then
      local playerName = self.game.save.player.name

      if winner == playerName then
        -- Japanese Blue TrainerDefeatedText
        message =
          loser .. "との\n" ..
          "しょうぶに　かった！"

      elseif loser == playerName then
        -- Japanese Blue LinkBattleLostText
        message =
          winner .. "との\n" ..
          "しょうぶに　まけた！"
      end
    end
  end

  return previousJPLinkSayNext(self, message, ...)
end

print("[JAPANESE_BLUE] Authentic link-battle result text active")

-- ================================================================
-- JAPANESE BLUE FINAL RUNTIME BATTLE FIXES
--
-- These cases cannot be represented faithfully as plain string-key
-- replacements because gen1recomp either combines/splits messages
-- differently from the cartridge or adds runtime arguments in a different
-- order. This wrapper runs last, after the recomp has constructed each
-- message. Blue-only via the top-level GameVersion.isBlue() guard.
-- ================================================================

local JPFinalBattleState = require("src.battle.BattleState")
local previousJPFinalSayNext = JPFinalBattleState.sayNext

JPFinalBattleState.sayNext = function(self, message, ...)
  if type(message) == "string" and self then
    -- Japanese Blue AIBattleUseItemText:
    --   <TRAINER>は　<ENEMY MON>に
    --   <ITEM>を　つかった
    -- Do this here rather than in TrainerAI.useItem so prefixEnemy() cannot
    -- inject the English word "Enemy" before the enemy Pokemon name.
    if self.trainer and self.enemy and not self._japaneseBlueMoveId then
      local who, itemName = message:match("^(.-)\nused (.-)!$")
      if who == self.trainer.name and itemName then
        message =
          who .. "は　" .. self.enemy.name .. "に\n" ..
          itemName .. "を　つかった"
      end
    end

    -- Japanese Blue ItemUseBallText00 is one two-line text event.
    -- gen1recomp emits it as two separate English messages; combine them
    -- and suppress only the immediately-following second half.
    if message == "It dodged the\nthrown BALL!" then
      self._japaneseBlueSkipCantCatch = true
      message = "よけられた！\nこいつは　つかまりそうにないぞ！"
    elseif message == "This POKéMON\ncan't be caught!"
        and self._japaneseBlueSkipCantCatch then
      self._japaneseBlueSkipCantCatch = nil
      return
    else
      self._japaneseBlueSkipCantCatch = nil
    end

    -- Japanese Blue ItemUseBallText07/08. The cartridge uses different
    -- wording for Bill's destination rather than merely substituting a PC
    -- label into one generic sentence.
    local caughtName, destination =
      message:match("^(.-) was\ntransferred to\n(.-)!$")
    if caughtName and destination then
      if destination == "BILL's PC" then
        message = caughtName .. "は　マサキの　ところへ\nてんそうされた！"
      elseif destination == "someone's PC" then
        message = caughtName .. "は　だれかの　PCに\nてんそうされた！"
      end
    end
  end

  return previousJPFinalSayNext(self, message, ...)
end

-- Ghost battles use a literal English display name in gen1recomp.
-- Japanese Blue stores the disguise name as ゆうれい.
local previousJPMakeGhost = JPFinalBattleState.makeGhost
JPFinalBattleState.makeGhost = function(self, ...)
  local result = previousJPMakeGhost(self, ...)
  if self and self.enemy then
    self.enemy.name = "ゆうれい"
    self.introText = Strings("The GHOST\nappeared!")
  end
  return result
end

local JPFinalBattleStrings = mod.content.strings

JPFinalBattleStrings:override(
  "The GHOST\nappeared!",
  "ゆうれいが　\nあらわれた！"
)

JPFinalBattleStrings:override(
  "But every BOX\nis full!",
  "ボックスに　あずけている　ポケモンが\nいっぱいなので　つかえません！"
)

JPFinalBattleStrings:override(
  "{RIVAL}: Yeah! Am\nI great or what?",
  "{RIVAL}『やりー！\nやっぱ　おれって　てんさい？"
)

print("[JAPANESE_BLUE] Final runtime battle fixes active")



