-- Exact Japanese Blue out-of-Safari-Balls announcement:
--
-- アナウンス『ピンポーン！
--
-- サファリ　ボールを
-- ぜんぶ　なげました！
JPMoveSafariStrings:override(
  "PA: You're out of\nSAFARI BALLs!\nGame over!",
  "アナウンス『ピンポーン！\vサファリ　ボールを\nぜんぶ　なげました！"
)

-- Gen1Recomp draws the Safari Ball count separately from the battle menu.
-- Japanese Blue instead prints the remaining count directly into
-- SAFARI_BATTLE_MENU_TEMPLATE, so this hook suppresses the standalone
-- counter and recreates the original Japanese menu placement.
local JPSafariFont = require("src.render.Font")
local previousSafariDraw = JPSafariFont.draw
local previousSafariDrawCode = JPSafariFont.drawCode

-- Japanese Blue writes the remaining Safari Ball count directly into
-- SAFARI_BATTLE_MENU_TEMPLATE at hlcoord 10,14 (80,112), rather than
-- displaying Gen1Recomp's separate English-style BALLx counter.
local K89SafariBallCount = nil

JPSafariFont.draw = function(value, x, y, ...)
  if type(value) == "string" then
    -- Actual runtime Safari Ball counter.
    -- Move two 8px character cells right: x56 -> x72.
    if y == 112 and x == 56 and value:match("^%d+$") then
      x = 80
    end

    if y == 112 then
      local f = io.open("/tmp/k89_safari_exact.log", "a")
      if f then
        f:write(string.format("value=%q x=%s y=%s\\n",
          tostring(value), tostring(x), tostring(y)))
        f:close()
      end
    end

    -- Capture Gen1Recomp's standalone BALLx count, but do not draw it.
    -- Normal renderer: (88,72)
    -- Wide renderer:   (200,72)
    if y == 72 and (x == 88 or x == 200) then
      local count = value:match("^BALLx%s*(%d+)$")
      if count then
        K89SafariBallCount = count
        return
      end
    end

    -- Japanese Blue SAFARI_BATTLE_MENU_TEMPLATE:
    --   label begins at col 2  = x16
    --   count is printed col 10 = x80
    if value == "サファリボール×" and x == 16 and y == 112 then
      previousSafariDraw(value, x, y, ...)

      if K89SafariBallCount then
        previousSafariDraw(K89SafariBallCount, 96, 112, ...)
      end

      return
    end

    -- Japanese Blue right-column text begins at col 13 = x104.
    -- Gen1Recomp's English layout begins it at x112.
    if x == 112 and (y == 112 or y == 128) then
      if value == "エサをなげる" or value == "にげる" then
        x = 104
      end
    end
  end

  return previousSafariDraw(value, x, y, ...)
end

JPSafariFont.drawCode = function(code, x, y, ...)
  -- Japanese Blue Safari right-column cursor is col 12 = x96.
  -- Gen1Recomp places it at x104.
  if code == 0xED and x == 104 and (y == 112 or y == 128) then
    x = 96
  end

  return previousSafariDrawCode(code, x, y, ...)
end



