-- ================================================================
-- JAPANESE BLUE POST-UPDATE COMPATIBILITY CLEANUP
-- ================================================================

-- The current recomp moved Oak's preset names into field.boot.namePresets.
-- Restore the exact Japanese Blue presets without touching Red/Yellow.
local JPFieldCompat = mod.content.field
JPFieldCompat:patch("boot", {
  namePresets = {
    player = { "ブルー", "ツネカズ", "ジャン" },
    rival  = { "レッド", "デギ", "ヒロシ" },
  },
})

-- Current battle modules still construct some enemy-side messages with the
-- international "Enemy " prefix before they reach the text queue.  Older
-- fixes only covered sayNext(); strip it at both queue entry points so every
-- Japanese Blue battle path is covered consistently.
local JPCompatBattleState = require("src.battle.BattleState")
local previousJPCompatSay = JPCompatBattleState.say
local previousJPCompatSayNext = JPCompatBattleState.sayNext

local function stripJapaneseBlueEnemyPrefix(message)
  if type(message) == "string" then
    message = message:gsub("Enemy ", "てきの　")
  end
  return message
end

JPCompatBattleState.say = function(self, message, ...)
  return previousJPCompatSay(self, stripJapaneseBlueEnemyPrefix(message), ...)
end

JPCompatBattleState.sayNext = function(self, message, ...)
  return previousJPCompatSayNext(self, stripJapaneseBlueEnemyPrefix(message), ...)
end

print("[JAPANESE_BLUE] Post-update preset/enemy-prefix cleanup active")

-- ================================================================
-- K89 RUNTIME NAMING FIX
-- ================================================================
--
-- The current recomp passes the international preset arrays directly
-- into NamingScreen, bypassing field.boot.namePresets.
--
-- Replace those arrays at the actual NamingScreen boundary.
-- K89 intentionally uses デギ as rival preset #2.
local previousK89NamingNew = NamingScreen.new

NamingScreen.new = function(game, opts)
  opts = opts or {}

  if type(opts.presets) == "table" and #opts.presets >= 3 then
    local first = opts.presets[1]

    if first == "BLUE" then
      local copy = {}
      for k, v in pairs(opts) do copy[k] = v end
      copy.presets = { "ブルー", "ツネカズ", "ジャン" }
      opts = copy

    elseif first == "RED" then
      local copy = {}
      for k, v in pairs(opts) do copy[k] = v end
      copy.presets = { "レッド", "デギ", "ヒロシ" }
      opts = copy
    end
  end

  return previousK89NamingNew(game, opts)
end


-- ================================================================
-- Scripted gifts (including Oak's starter) do NOT use
-- BattleState.askNicknameUI. Commands.give_pokemon stores the English
-- species display name in game.stringBuffer, and Commands.askNickname
-- passes that value as RAM to _DoYouWantToNicknameText.
--
-- Translate only that RAM substitution at the actual show_text boundary.



-- ================================================================
-- K89 BLUE GIVE_POKEMON / NICKNAME FIX
-- ================================================================
-- Oak starters and scripted gift Pokémon use the give_pokemon script
-- command. Override that command through the official mod registry so the
-- actual ScriptRunner dispatch reaches this implementation.
--
-- This mirrors src/script/Commands.lua's vanilla give_pokemon behavior,
-- except the AskName prompt uses JP_POKEMON_NAMES directly.

local K89Commands   = require("src.script.Commands")
local K89Pokemon    = require("src.pokemon.Pokemon")
local K89Party      = require("src.pokemon.Party")
local K89Boxes      = require("src.pokemon.Boxes")
local K89Battle     = require("src.battle.BattleState")
local K89Screens    = require("src.ui.Screens")
local K89ChoiceBox  = require("src.ui.ChoiceBox")

local function K89AskJapaneseNickname(ctx, mon, species)
  local runner = ctx.runner
  if not runner then return end

  local success = ctx.lastCheck

  local englishName =
    (ctx.game.data.pokemon[species]
      and ctx.game.data.pokemon[species].name)
    or species

  local jpName =
    JP_POKEMON_NAMES[species]
    or JP_POKEMON_NAMES[englishName]
    or englishName

  -- Do not let vanilla show_text replace the Japanese name with
  -- ctx.pendingPokemonName.
  ctx.pendingPokemonName = nil
  ctx.game.stringBuffer = jpName

  K89Commands.show_text(
    ctx,
    jpName .. "に\nニックネームを　つけますか？"
  )

  ctx.game.stack:push(K89ChoiceBox.new(ctx.game, function(yes)
    if not yes then
      ctx.lastCheck = success
      runner:resume()
      return
    end

    K89Screens.push(ctx.game, "NamingScreen", {
      title = "ニックネームは？",
      maxLen = 5,
      onDone = function(nick)
        if nick and #nick > 0 then
          mon.nickname = nick
        end
        ctx.lastCheck = success
        runner:resume()
      end,
    })
  end))

  runner:yield()
  ctx.lastCheck = success
end


mod.content.commands:override("give_pokemon", function(ctx, species, level, skipNickname)

  -- Preserve vanilla pokemon.before_give mod event behavior.
  local gift = {
    ctx = ctx,
    species = species,
    level = level,
  }

  if ctx.game.mods then
    ctx.game.mods.events:emit("pokemon.before_give", gift)
    species = gift.species
    level = gift.level
  end

  local mon = K89Pokemon.new(ctx.game.data, species, level)

  if gift.nickname then
    mon.nickname = gift.nickname
  end

  local englishName =
    (ctx.game.data.pokemon[species]
      and ctx.game.data.pokemon[species].name)
    or species

  local jpName =
    JP_POKEMON_NAMES[species]
    or JP_POKEMON_NAMES[englishName]
    or englishName

  ctx.game.stringBuffer = jpName
  ctx.pendingPokemonName = nil

  K89Battle.stampOT(ctx.save, mon)

  local addedToParty = K89Party.add(ctx.save.party, mon)
  local boxNum = nil

  if not addedToParty then
    boxNum = K89Boxes.deposit(ctx.save, mon)

    if not boxNum then
      ctx.lastCheck = false
      return
    end
  end

  local dex = ctx.save.pokedex
  if dex then
    dex.seen[species] = true
    dex.owned[species] = true
  end

  ctx.lastCheck = true
  ctx.addedToParty = addedToParty
  ctx.boxNum = boxNum

  -- Vanilla AskName behavior, but with Japanese species text.
  if not gift.nickname and not skipNickname and ctx.runner then
    K89AskJapaneseNickname(ctx, mon, species)
  end

  -- Preserve vanilla box-deposit behavior.
  if boxNum then
    local name =
      mon.nickname
      or JP_POKEMON_NAMES[species]
      or JP_POKEMON_NAMES[englishName]
      or englishName

    ctx.game.boxMonNicks = name
    ctx.game.stringBuffer = tostring(boxNum)

    if ctx.runner then
      K89Commands.show_text(ctx, "_SentToBoxText")
    else
      local TextBox = require("src.render.TextBox")
      local Strings = require("src.core.Strings")
      local raw =
        ctx.game.data.text
        and ctx.game.data.text._SentToBoxText

      ctx.game.stack:push(TextBox.new(
        ctx.game,
        raw or Strings(
          "There's no more\nroom for POKéMON!\v%s was\vsent to POKéMON\vBOX %s on PC!",
          name,
          boxNum
        ),
        function() end
      ))
    end
  end
end)

print("[JAPANESE_BLUE] give_pokemon registry override active")


-- ================================================================
-- K89 FINAL BATTLE TEXT RENDER NORMALIZATION
-- ================================================================
-- This is the final textual boundary before BattleState converts a queued
-- message into glyph codes with Font.encode().  Translate the international
-- enemy marker here so no upstream producer can leak literal "Enemy ".
local K89FinalBattleText = require("src.battle.BattleState")
local previousK89StartMessage = K89FinalBattleText.startMessage

K89FinalBattleText.startMessage = function(self, item, ...)
  if type(item) == "table" and type(item.text) == "string"
      and item.text:find("Enemy ", 1, true) then

    -- Do not mutate the original queued table in case another subsystem
    -- retains a reference to it.
    local copy = {}
    for k, v in pairs(item) do
      copy[k] = v
    end

    copy.text = copy.text:gsub("Enemy ", "てきの　")
    item = copy
  end

  -- Japanese move announcements belong on two lines:
  --
  --   PLAYER:
  --     ゼニガメの
  --     たいあたり　こうげき！
  --
  --   ENEMY:
  --     てきの　フシギダネの
  --     なきごえ　こうげき！
  --
  -- Upstream can hand us either form as one continuous line.  Repair both
  -- sides here at the final textual boundary before glyph encoding.
  if type(item) == "table" and type(item.text) == "string"
      and not item.text:find("\n", 1, true)
      and self then

    local prefixes = {}

    if self.enemy and type(self.enemy.name) == "string" then
      prefixes[#prefixes + 1] = "てきの　" .. self.enemy.name
    end

    if self.player and type(self.player.name) == "string" then
      prefixes[#prefixes + 1] = self.player.name
    end

    for _, prefix in ipairs(prefixes) do
      if item.text:sub(1, #prefix) == prefix then
        local rest = item.text:sub(#prefix + 1)

        local particle = nil

        if rest:sub(1, #"は　") == "は　" then
          particle = "は　"
        elseif rest:sub(1, #"は") == "は" then
          particle = "は"
        elseif rest:sub(1, #"の　") == "の　" then
          particle = "の　"
        elseif rest:sub(1, #"の") == "の" then
          particle = "の"
        end

        if particle then
          local tail = rest:sub(#particle + 1)

          -- Restrict this repair strictly to used-move announcements.
          local isMove =
               tail:find("を　つかった！", 1, true)
            or tail:find("を　した！", 1, true)
            or tail:find("した！", 1, true)
            or tail:find("　こうげき！", 1, true)

          if isMove then
            local copy = {}
            for k, v in pairs(item) do
              copy[k] = v
            end

            copy.text = prefix .. particle .. "\n" .. tail
            item = copy
            break
          end
        end
      end
    end
  end

  return previousK89StartMessage(self, item, ...)
end

print("[JAPANESE_BLUE] Final battle Enemy prefix render fix active")


-- ================================================================
-- K89 JAPANESE WIDE BATTLE LAYOUT
-- ================================================================
-- WideBattle's drawCommandMenu/drawMoveGrid functions are local to that
-- module.  Track the active wide battle and adjust only their known
-- coordinates while this Blue-only mod is active.
local K89WideBattle = require("src.battle.WideBattle")
local K89WideFont = require("src.render.Font")

local previousK89WideDraw = K89WideBattle.draw
local previousK89WideFontDraw = K89WideFont.draw
local previousK89WideFontDrawCode = K89WideFont.drawCode

local K89ActiveWideBattle = nil

K89WideBattle.draw = function(battle, ...)
  local previous = K89ActiveWideBattle
  K89ActiveWideBattle = battle

  local results = { previousK89WideDraw(battle, ...) }

  K89ActiveWideBattle = previous
  return unpack(results)
end

K89WideFont.draw = function(value, x, y, ...)
  local battle = K89ActiveWideBattle

  if battle then
    if battle.phase == "menu" and not battle.safari then
      -- Command labels: lift both rows 4px.
      if y == 112 then
        y = 108
      elseif y == 128 then
        y = 124
      end

      -- Japanese right command column needs substantially more room.
      -- Pull RUN / right-side text 40px left from the stock wide position.
      if x == 240 then
        x = 200
      end

    elseif battle.phase == "moveSelect"
        or battle.phase == "mimicSelect" then
      -- Japanese dakuten/handakuten occupy pixels above the base glyph.
      -- Move row 1 down slightly and keep row 2 separated.
      if (x == 16 or x == 120) and y == 112 then
        y = 114
      elseif (x == 16 or x == 120) and y == 128 then
        y = 132
      end
    end
  end

  return previousK89WideFontDraw(value, x, y, ...)
end

K89WideFont.drawCode = function(code, x, y, ...)
  local battle = K89ActiveWideBattle

  if battle then
    if battle.phase == "menu" and not battle.safari then
      if y == 112 then
        y = 108
      elseif y == 128 then
        y = 124
      end

      -- PK/MN glyph pair and right-column cursor follow the Japanese
      -- right command column farther left.
      if x == 240 then
        x = 200
      elseif x == 248 then
        x = 208
      elseif x == 232 then
        x = 192
      end

    elseif battle.phase == "moveSelect"
        or battle.phase == "mimicSelect" then
      -- Keep the cursor aligned with the adjusted Japanese move rows.
      if (x == 8 or x == 112) and y == 112 then
        y = 114
      elseif (x == 8 or x == 112) and y == 128 then
        y = 132
      end
    end
  end

  return previousK89WideFontDrawCode(code, x, y, ...)
end

print("[JAPANESE_BLUE] Japanese wide battle layout active")


-- K89 V2 FINAL MAP NAME OVERRIDES
-- Final two audited Japanese Blue map-name surfaces.
-- These names originate from game.data.field.townMap.locations[*].name.
local function K89V2ApplyFinalMapNames(game)
  if not game or not game.data then return end

  local field = game.data.field
  if type(field) ~= "table" then return end

  local townMap = field.townMap
  if type(townMap) ~= "table" then return end

  local locations = townMap.locations or townMap
  if type(locations) ~= "table" then return end

  for _, loc in pairs(locations) do
    if type(loc) == "table" then
      if loc.name == "SEA COTTAGE" then
        loc.name = "みさき　の　こや"
      elseif loc.name == "ROCKET HQ" then
        loc.name = "ロケットだんアジト"
      end
    end
  end
end

local K89V2OriginalLoveUpdate = love.update
love.update = function(dt)
  if K89V2OriginalLoveUpdate then
    K89V2OriginalLoveUpdate(dt)
  end

  if not K89V2FinalMapNamesApplied then
    local ok = pcall(function()
      if Game then
        K89V2ApplyFinalMapNames(Game)
        K89V2FinalMapNamesApplied = true
      end
    end)

    if not ok then
      K89V2FinalMapNamesApplied = false
    end
  end
end

-- ================================================================
-- K89 POKEMON BLUE JP HEN: STANDALONE NAMING-SCREEN MARK RENDERING
-- ================================================================

do
  local NamingScreen = require("src.ui.NamingScreen")
  local previousDraw = NamingScreen.draw

  local dakutenImage
  local handakutenImage

  local function loadMarks()
    if dakutenImage then return end

    dakutenImage =
      love.graphics.newImage(mod.assets:path("assets/jp_dakuten.png"))

    handakutenImage =
      love.graphics.newImage(mod.assets:path("assets/jp_handakuten.png"))

    if dakutenImage.setFilter then
      dakutenImage:setFilter("nearest", "nearest")
    end

    if handakutenImage.setFilter then
      handakutenImage:setFilter("nearest", "nearest")
    end
  end

  function NamingScreen:draw()
    previousDraw(self)

    loadMarks()

    local grid = self:grid()
    local startY = 34
    local rowStep = 14

    for r = 1, 6 do
      local row = grid[r]

      if row then
        for c, cell in ipairs(row) do

          if cell == "゛" then
            love.graphics.setColor(0, 0, 0, 1)
            love.graphics.draw(
              dakutenImage,
              c * 16 + 1,
              startY + (r - 1) * rowStep
            )

          elseif cell == "゜" then
            love.graphics.setColor(0, 0, 0, 1)
            love.graphics.draw(
              handakutenImage,
              c * 16 + 1,
              startY + (r - 1) * rowStep
            )
          end

        end
      end
    end

    love.graphics.setColor(1, 1, 1, 1)
  end
end

print("[K89_POKEMON_BLUE_JP_HEN] standalone naming marks rendering active")


-- K89 MR PSYCHIC TM29 JAPANESE RUNTIME FIX
--
-- Gen1Recomp story4.lua currently routes this interaction through a
-- nonexistent _MrPsychicsHouseMrPsychicText key and hard-coded English
-- strings for the item-received / bag-full branches. It also omits the
-- original TM29 explanation sequence.
--
-- K89 already contains the canonical Japanese Blue text for all four
-- original labels, so replace only this runtime handler and make it use
-- those existing strings.

do
  local Story4 = require("data.scripts.story4")
  local Bag = require("src.inventory.Bag")
  local TextBox = require("src.render.TextBox")

  local function k89MrPsychicPush(game, s, done)
    game.stack:push(TextBox.new(game, s, done))
  end

  local function k89MrPsychicFill(s, subs)
    subs = subs or {}

    s = s:gsub("{PLAYER}", subs.player or "")
    s = s:gsub("{RAM:[^}]*}", function()
      return subs.ram or ""
    end)

    return s
  end

  local house = Story4.MR_PSYCHICS_HOUSE

  if house and house.talk then
    house.talk.TEXT_MRPSYCHICSHOUSE_MR_PSYCHIC =
      function(game, ow, npc, done)

        local t = game.data.text
        local flags = game.save.flags
        local itemId = "TM_PSYCHIC_M"
        local itemName =
          (game.data.items[itemId] and game.data.items[itemId].name)
          or "TM29"

        local explanation =
          t._MrPsychicsHouseMrPsychicTM29ExplanationText
          or "⋯　わかってるな？\nわざマシン２９は　サイコキネシス！\012⋯　うまく　いけば\nあいての　とくしゅ　のうりょくを\011さげられる　かも　しれない！"

        -- Original behavior after TM29 has already been received:
        -- Mr. Psychic repeats the TM29 explanation.
        if flags.EVENT_GOT_TM29 then
          k89MrPsychicPush(game, explanation, done)
          return
        end

        local intro =
          t._MrPsychicsHouseMrPsychicYouWantedThisText
          or "⋯　⋯　わかった！\012これが　ほしい　のか！"

        k89MrPsychicPush(game, intro, function()

          if not Bag.add(game.save, itemId, 1) then
            local noRoom =
              t._MrPsychicsHouseMrPsychicTM29NoRoomText
              or "もちものが　いっぱいだ！"

            k89MrPsychicPush(game, noRoom, done)
            return
          end

          flags.EVENT_GOT_TM29 = true

          local received =
            t._MrPsychicsHouseMrPsychicReceivedTM29Text
            or "{PLAYER}は　エスパー　から\n{RAM:wStringBuffer}を　もらった！"

          received = k89MrPsychicFill(received, {
            player = game.save.player.name,
            ram = itemName,
          })

          k89MrPsychicPush(game, received, function()
            k89MrPsychicPush(game, explanation, done)
          end)
        end)
      end
  end
end

print("[K89_POKEMON_BLUE_JP_HEN] Mr. Psychic TM29 Japanese runtime fix active")


-- K89 ROUTE 16 HM02 JAPANESE RUNTIME FIX
--
-- Gen1Recomp story4.lua requests Hm02 instead of canonical HM02 for
-- the repeat explanation and hard-codes English for the received-item
-- and bag-full branches. Restore the canonical Japanese Blue sequence.

do
  local Story4 = require("data.scripts.story4")
  local Bag = require("src.inventory.Bag")
  local TextBox = require("src.render.TextBox")

  local function k89Route16Push(game, s, done)
    game.stack:push(TextBox.new(game, s, done))
  end

  local function k89Route16FillPlayer(s, game)
    return (s:gsub("{PLAYER}", game.save.player.name or ""))
  end

  local house = Story4.ROUTE_16_FLY_HOUSE

  if house and house.talk then
    house.talk.TEXT_ROUTE16FLYHOUSE_BRUNETTE_GIRL =
      function(game, ow, npc, done)

        local t = game.data.text
        local flags = game.save.flags

        local explanation =
          t._Route16FlyHouseBrunetteGirlHM02ExplanationText
          or "ひでんマシン０２は　そらをとぶ！"

        if flags.EVENT_GOT_HM02 then
          k89Route16Push(game, explanation, done)
          return
        end

        local intro =
          t._Route16FlyHouseBrunetteGirlText
          or "あらま⋯！\nみつかっちゃったわね！"

        k89Route16Push(game, intro, function()

          if not Bag.add(game.save, "HM_FLY", 1) then
            local noRoom =
              t._Route16FlyHouseBrunetteGirlHM02NoRoomText
              or "あなた　にもつ　いっぱいよ"

            k89Route16Push(game, noRoom, done)
            return
          end

          flags.EVENT_GOT_HM02 = true

          local received =
            t._Route16FlyHouseBrunetteGirlReceivedHM02Text
            or "{PLAYER}は　おんなのこから\nひでんマシン０２を　もらった！"

          received = k89Route16FillPlayer(received, game)

          k89Route16Push(game, received, function()
            k89Route16Push(game, explanation, done)
          end)
        end)
      end
  end
end

print("[K89_POKEMON_BLUE_JP_HEN] Route 16 HM02 Japanese runtime fix active")


