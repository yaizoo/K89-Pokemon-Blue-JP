local JP_RUNTIME_FIRST = 256
local JP_RUNTIME_LAST = 423
local JP_RUNTIME_IMAGE = nil
local JP_RUNTIME_QUADS = nil

local function loadJapaneseRuntimeFont()
  if JP_RUNTIME_IMAGE then return end
  local path = mod.assets:path("assets/font_japanese.png")
  JP_RUNTIME_IMAGE = love.graphics.newImage(path)
  if JP_RUNTIME_IMAGE.setFilter then
    JP_RUNTIME_IMAGE:setFilter("nearest", "nearest")
  end
  local iw, ih = JP_RUNTIME_IMAGE:getDimensions()
  JP_RUNTIME_QUADS = {}
  local perRow = 16
  for code = JP_RUNTIME_FIRST, JP_RUNTIME_LAST do
    local i = code - JP_RUNTIME_FIRST
    JP_RUNTIME_QUADS[code] = love.graphics.newQuad(
      (i % perRow) * 8, math.floor(i / perRow) * 8, 8, 8, iw, ih
    )
  end
end

JPFontRuntime.split = function(text)
  local spans = previousJPSplit(text)
  if type(text) == "string" then
    for _, span in ipairs(spans) do
      -- IMPORTANT: the imported US Blue cache already contains a Japanese
      -- charmap, but those entries point at the US $60-$FF font pages.
      -- Therefore Japanese spans often arrive with a NON-nil, but wrong,
      -- code.  Replace every sequence we own, not only missing sequences.
      local seq = text:sub(span.from, span.to)
      local code = JP_RUNTIME_CODE[seq]
      if code then span.code = code end
    end
  end
  return spans
end

-- Japanese Blue stores voiced/semi-voiced kana as text codes, but
-- PlaceString converts them back to the plain kana and places ゛/゜
-- one tile row above.  Reproduce that layout here instead of baking
-- the diacritic into the 8x8 base glyph.
local JP_DIACRITIC_BASE = {
  [373]=272, [374]=273, [375]=274, [376]=275, [377]=276,
  [378]=277, [379]=278, [380]=279, [381]=280, [382]=281,
  [383]=282, [384]=283, [385]=285, [386]=286, [387]=287,
  [388]=293, [389]=294, [390]=295, [391]=296, [392]=297,

  [393]=327, [394]=328, [395]=329, [396]=330, [397]=331,
  [398]=332, [399]=333, [400]=334, [401]=335, [402]=336,
  [403]=337, [404]=338, [405]=340, [406]=341, [407]=342,
  [408]=348, [409]=349, [410]=350, [411]=371, [412]=351,
  [413]=322,

  [414]=293, [415]=294, [416]=295, [417]=296, [418]=297,
  [419]=348, [420]=349, [421]=350, [422]=371, [423]=351,
}

local JP_DAKUTEN_IMAGE = nil
local JP_HANDAKUTEN_IMAGE = nil

local function loadJapaneseDiacritics()
  if JP_DAKUTEN_IMAGE then return end

  JP_DAKUTEN_IMAGE =
    love.graphics.newImage(mod.assets:path("assets/jp_dakuten.png"))
  JP_HANDAKUTEN_IMAGE =
    love.graphics.newImage(mod.assets:path("assets/jp_handakuten.png"))

  if JP_DAKUTEN_IMAGE.setFilter then
    JP_DAKUTEN_IMAGE:setFilter("nearest", "nearest")
  end
  if JP_HANDAKUTEN_IMAGE.setFilter then
    JP_HANDAKUTEN_IMAGE:setFilter("nearest", "nearest")
  end
end

JPFontRuntime.drawCode = function(code, x, y, ...)
  if type(code) == "number"
      and code >= JP_RUNTIME_FIRST and code <= JP_RUNTIME_LAST then
    loadJapaneseRuntimeFont()

    local baseCode = JP_DIACRITIC_BASE[code]

    if baseCode then
      local baseQuad = JP_RUNTIME_QUADS[baseCode]

      if baseQuad then
        -- Plain kana occupies the normal character row.
        love.graphics.draw(JP_RUNTIME_IMAGE, baseQuad, x, y)

        -- Original Japanese Blue places the diacritic tile one
        -- SCREEN_WIDTH row above the plain kana.
        loadJapaneseDiacritics()

        if code <= 413 then
          love.graphics.draw(JP_DAKUTEN_IMAGE, x + 1, y - 7)
        else
          love.graphics.draw(JP_HANDAKUTEN_IMAGE, x + 1, y - 7)
        end

        return
      end
    end

    local quad = JP_RUNTIME_QUADS[code]
    if quad then
      love.graphics.draw(JP_RUNTIME_IMAGE, quad, x, y)
      return
    end
  end

  return previousJPDrawCode(code, x, y, ...)
end

JPFontRuntime.advanceOf = function(code)
  if type(code) == "number"
      and code >= JP_RUNTIME_FIRST and code <= JP_RUNTIME_LAST then
    return 8
  end
  return previousJPAdvanceOf(code)
end

print("[JAPANESE_BLUE] Japanese font runtime bridge active")


