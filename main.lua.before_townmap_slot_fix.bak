-- ================================================================
-- JAPANESE FONT RUNTIME BRIDGE
--
-- gen1recomp 0.1.56+ can load mod font pages through Data.font, but the
-- post-update build can still reach text paths before/without the merged
-- page/charmap being used consistently.  This bridge makes Japanese Blue
-- independent of that merge path: unknown UTF-8 kana spans are assigned
-- our bundled codes directly, and those codes draw from the bundled sheet.
-- All non-Japanese glyphs delegate to the engine unchanged.
-- ================================================================

local JPFontRuntime = require("src.render.Font")
local previousJPSplit = JPFontRuntime.split
local previousJPDrawCode = JPFontRuntime.drawCode
local previousJPAdvanceOf = JPFontRuntime.advanceOf

local JP_RUNTIME_CODE = {
  ["　"] = 256,
  ["。"] = 257,
  ["「"] = 258,
  ["」"] = 259,
