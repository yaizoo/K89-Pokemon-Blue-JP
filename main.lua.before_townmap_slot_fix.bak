-- Raw menu labels that bypass Strings().  Translate before Menu.new sizes
-- the box so Japanese labels cannot overflow because width was measured
-- from the English text.
local JPMenu = require("src.ui.Menu")
local previousJPFullMenuNew = JPMenu.new
local JP_RAW_MENU = {
  ["BILL'S PC"] = "マサキの　PC",
  ["SOMEONE'S PC"] = "だれかの　PC",
  ["PROF.OAK's PC"] = "オーキドの　PC",
  ["LOG OFF"] = "でんげんを　きる",
}

JPMenu.new = function(game, items, opts)
  if type(items) == "table" then
    for _, item in ipairs(items) do
      if type(item) == "table" and type(item.label) == "string" then
        local label = JP_RAW_MENU[item.label]
        if not label then
          local owner = item.label:match("^(.-)'s PC$")
          if owner then label = owner .. "の　PC" end
        end
        if label then item.label = label end
      end
    end
  end
  return previousJPFullMenuNew(game, items, opts)
end

-- Battle stat-change messages carry English stat names as runtime values,
-- so a literal Strings override alone cannot make ATTACK/ACCURACY/etc.
-- Japanese. Rewrite the final formatted message using Japanese Blue's
-- StatModTextStrings and RoseText/FellText grammar.
local JPFullBattleState = require("src.battle.BattleState")
local previousJPFullSayNext = JPFullBattleState.sayNext
local JP_BATTLE_STAT_NAMES = {
  ATTACK = "こうげきりょく",
  DEFENSE = "ぼうぎょりょく",
  SPEED = "すばやさ",
  SPECIAL = "とくしゅのうりょく",
  ACCURACY = "めいちゅうりつ",
  EVASION = "かいひりつ",
}

JPFullBattleState.sayNext = function(self, message, ...)
  if type(message) == "string" then
    local who, stat = message:match("^(.-)'s\n([A-Z]+) rose!$")
    if who and JP_BATTLE_STAT_NAMES[stat] then
      message = who .. "の\n" .. JP_BATTLE_STAT_NAMES[stat] .. "が　あがった！"
    else
      who, stat = message:match("^(.-)'s\n([A-Z]+)\ngreatly rose!$")
      if who and JP_BATTLE_STAT_NAMES[stat] then
        message = who .. "の\n" .. JP_BATTLE_STAT_NAMES[stat] .. "が\nぐーんと　あがった！"
      else
        who, stat = message:match("^(.-)'s\n([A-Z]+) fell!$")
        if who and JP_BATTLE_STAT_NAMES[stat] then
          message = who .. "の\n" .. JP_BATTLE_STAT_NAMES[stat] .. "が　さがった！"
        else
          who, stat = message:match("^(.-)'s\n([A-Z]+)\ngreatly fell!$")
          if who and JP_BATTLE_STAT_NAMES[stat] then
            message = who .. "の\n" .. JP_BATTLE_STAT_NAMES[stat] .. "が\nがくっと　さがった！"
          end
        end
      end
    end
  end
  return previousJPFullSayNext(self, message, ...)
end



