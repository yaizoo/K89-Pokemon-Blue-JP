-- ================================================================
-- JAPANESE NAMING SCREEN
-- ================================================================

local NamingScreen = require("src.ui.NamingScreen")
local Font = require("src.render.Font")
local Theme = require("src.ui.Theme")
local Strings = require("src.core.Strings")

-- Exact Japanese Gen-1 Blue kana tables:
--
-- HiraganaCharacters
-- KatakanaCharacters
--
-- The final one-cell row performs the kana-page switch.
local GRID_HIRAGANA = {
  { "あ","か","さ","た","な","は","ま","や","ら" },
  { "い","き","し","ち","に","ひ","み","ゆ","り" },
  { "う","く","す","つ","ぬ","ふ","む","よ","る" },
  { "え","け","せ","て","ね","へ","め","わ","れ" },
  { "お","こ","そ","と","の","ほ","も","ん","ろ" },
  { "ゃ","ゅ","ょ","っ","゛","゜","ー"," ","ED" },
  { "lower" },
}

local GRID_KATAKANA = {
  { "ア","カ","サ","タ","ナ","ハ","マ","ヤ","ラ" },
  { "イ","キ","シ","チ","ニ","ヒ","ミ","ユ","リ" },
  { "ウ","ク","ス","ツ","ヌ","フ","ム","ヨ","ル" },
  { "エ","ケ","セ","テ","ネ","ヘ","メ","ワ","レ" },
  { "オ","コ","ソ","ト","ノ","ホ","モ","ン","ロ" },
  { "ャ","ュ","ョ","ッ","゛","゜","ー"," ","ED" },
  { "UPPER" },
}

-- Japanese Gen-1 naming screen starts on katakana.
-- NamingScreen uses `lower` as its alternate-page flag, so:
-- false = katakana
-- true  = hiragana
function NamingScreen:grid()
  return self.lower and GRID_HIRAGANA or GRID_KATAKANA
end

-- Japanese R/B use five visible name characters.
local originalNew = NamingScreen.new

NamingScreen.new = function(game, opts)
  local self = originalNew(game, opts)

  self.maxLen = math.min(self.maxLen or 5, 5)

  -- Japanese version starts on katakana.
  self.lower = false

  return self
end

-- ================================================================
-- DAKUTEN / HANDAKUTEN
--
-- The Game Boy version modifies the preceding kana rather than storing
-- the mark as another independent character. Reproduce that behavior.
-- ================================================================

local DAKUTEN = {
  ["か"]="が", ["き"]="ぎ", ["く"]="ぐ", ["け"]="げ", ["こ"]="ご",
  ["さ"]="ざ", ["し"]="じ", ["す"]="ず", ["せ"]="ぜ", ["そ"]="ぞ",
  ["た"]="だ", ["ち"]="ぢ", ["つ"]="づ", ["て"]="で", ["と"]="ど",
  ["は"]="ば", ["ひ"]="び", ["ふ"]="ぶ", ["へ"]="べ", ["ほ"]="ぼ",

  ["カ"]="ガ", ["キ"]="ギ", ["ク"]="グ", ["ケ"]="ゲ", ["コ"]="ゴ",
  ["サ"]="ザ", ["シ"]="ジ", ["ス"]="ズ", ["セ"]="ゼ", ["ソ"]="ゾ",
  ["タ"]="ダ", ["チ"]="ヂ", ["ツ"]="ヅ", ["テ"]="デ", ["ト"]="ド",
  ["ハ"]="バ", ["ヒ"]="ビ", ["フ"]="ブ", ["ヘ"]="ベ", ["ホ"]="ボ",
}

local HANDAKUTEN = {
  ["は"]="ぱ", ["ひ"]="ぴ", ["ふ"]="ぷ", ["へ"]="ぺ", ["ほ"]="ぽ",
  ["ハ"]="パ", ["ヒ"]="ピ", ["フ"]="プ", ["ヘ"]="ペ", ["ホ"]="ポ",
}

local originalUpdate = NamingScreen.update

function NamingScreen:update(dt)
  originalUpdate(self, dt)

  local n = #self.glyphs
  if n < 2 then return end

  local mark = self.glyphs[n]

  if mark ~= "゛" and mark ~= "゜" then
    return
  end

  local previous = self.glyphs[n - 1]
  local replacement

  if mark == "゛" then
    replacement = DAKUTEN[previous]
  else
    replacement = HANDAKUTEN[previous]
  end

  if replacement then
    self.glyphs[n - 1] = replacement
    table.remove(self.glyphs, n)

    -- The original update may have moved the cursor to ED because it
    -- temporarily counted the mark as another character. Return to the
    -- kana grid if there is still room.
    if #self.glyphs < self.maxLen then
      self.row = math.min(self.row, 6)
      self.col = math.min(self.col, 9)
    end
  end
end

-- ================================================================
-- JAPANESE NAMING-SCREEN DRAW LAYOUT
--
-- The English engine assumes only five alphabet rows. Japanese Blue has
-- six kana rows plus the kana-page switch, so its vertical spacing must
-- be tighter or the final row would fall below the 144px framebuffer.
-- ================================================================

function NamingScreen:draw()
  love.graphics.setColor(1, 1, 1, 1)
  love.graphics.rectangle("fill", 0, 0, 160, 144)

  love.graphics.setColor(0, 0, 0, 1)

  -- Header.
  Font.draw(self.title, 8, 6)

  -- Typed name.
  for i = 1, self.maxLen do
    Font.draw(self.glyphs[i] or "-", 104 + (i - 1) * 8, 22)
  end

  local grid = self:grid()

  -- Six Japanese 9-column kana rows.
  local startY = 34
  local rowStep = 14

  for r = 1, 6 do
    local row = grid[r]
    for c, cell in ipairs(row) do
      Font.draw(Strings(cell), c * 16, startY + (r - 1) * rowStep)
    end
  end

  -- Kana-page switch.
  Font.draw(Strings(grid[7][1]), 16, 122)

  -- Cursor.
  local cursorY

  if self.row == 7 then
    cursorY = 122
  else
    cursorY = startY + (self.row - 1) * rowStep
  end

  Font.drawCode(
    Theme.cursor,
    self.col * 16 - 8,
    cursorY
  )

  love.graphics.setColor(1, 1, 1, 1)
end

-- ================================================================
-- PLAYER PC SUBMENU TITLES
--
-- PlayerPC's first menu uses Strings(), but its ListMenu titles are raw
-- English literals. Translate only those exact titles, and only because
-- this module is loaded in the Blue process.
-- ================================================================

local ListMenu = require("src.ui.ListMenu")
local originalListMenuNew = ListMenu.new

local PC_TITLES = {
  ["WITHDRAW ITEM"] = "どうぐを　ひきだす",
  ["DEPOSIT ITEM"]  = "どうぐを　あずける",
  ["TOSS ITEM"]     = "どうぐを　すてる",
  ["ITEMS"]         = "どうぐ",
}

ListMenu.new = function(game, title, items, opts)
  title = PC_TITLES[title] or title
  return originalListMenuNew(game, title, items, opts)
end

print("[JAPANESE_BLUE] Japanese Blue UI active")

