local function japaneseUsedMoveText(name, moveName, moveId)
  local grammar = JP_MOVE_GRAMMAR[moveId] or 4

  if grammar == 0 then
    return name .. "は　\n" .. moveName .. "を　つかった！"
  elseif grammar == 1 then
    return name .. "は　\n" .. moveName .. "を　した！"
  elseif grammar == 2 then
    return name .. "は　\n" .. moveName .. "した！"
  elseif grammar == 3 then
    return name .. "の　\n" .. moveName .. "　こうげき！"
  end

  return name .. "の　\n" .. moveName .. "！"
end

local JPBattleState = require("src.battle.BattleState")

local originalJPPerformMove = JPBattleState.performMove
local originalJPSayNext = JPBattleState.sayNext

JPBattleState.performMove = function(self, user, target, moveInst, isCalled)
  local previousMove = self._japaneseBlueMoveId
  local def = self:moveDef(moveInst)
  self._japaneseBlueMoveId =
    (def and def.id) or (moveInst and moveInst.id) or nil

  local result = originalJPPerformMove(self, user, target, moveInst, isCalled)

  self._japaneseBlueMoveId = previousMove
  return result
end

JPBattleState.sayNext = function(self, text, ...)
  if type(text) == "string" then
    -- Japanese Blue never prints the English localization prefix.
    text = text:gsub("^Enemy ", "")

    local who, moveName = text:match("^(.-)\nused (.-)!$")

    if who and self._japaneseBlueMoveId then
      text = japaneseUsedMoveText(
        who, moveName, self._japaneseBlueMoveId
      )
    end
  end

  return originalJPSayNext(self, text, ...)
end

